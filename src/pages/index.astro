---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const principles = (await getCollection("principles")).sort(
  (a, b) => a.data.order - b.data.order,
);
const products = (await getCollection("products")).sort(
  (a, b) => a.data.order - b.data.order,
);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Layout
  title="Home"
  description="Open-source designs for ecologically-sound consumer goods, made together."
>
  <section class="hero">
    <div class="container hero-inner">
      <span class="tag">v0.1 &middot; open for revision</span>
      <h1>Open-source designs for ecologically-sound consumer goods.</h1>
      <p class="lede">
        OpenEcoGoods is a community effort to design consumer products that
        are genuinely built to last, repair, and return safely to the earth
        &mdash; and to publish those designs openly so anyone can build,
        improve, or manufacture them. Nothing here is finished. It's meant to
        be argued with.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`${base}principles`}>Read the principles</a>
        <a class="btn btn-ghost" href="https://github.com/3IVIS/openecogoods">
          Contribute on GitHub
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">What "ecological" means here</span>
      <h2>Seven working principles</h2>
      <p class="section-lede">
        We work from a short, opinionated set of principles rather than
        vague good intentions. They're a draft &mdash; open for revision.
      </p>
      <ol class="grid principles-grid">
        {
          principles.map((p) => (
            <li class="card principle-card">
              <span class="principle-number">{p.data.order}</span>
              <strong>{p.data.title}</strong>
              <p>{p.data.summary}</p>
            </li>
          ))
        }
      </ol>
      <a class="link-more" href={`${base}principles`}>Read the full principles &rarr;</a>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">What we're designing first</span>
      <h2>A draft shortlist, not a decision</h2>
      <p class="section-lede">
        We can't start everywhere. Below is a candidate shortlist, scored on
        environmental impact and how feasible open, distributed manufacture
        actually is &mdash; an opening bid for discussion.
      </p>
      <ul class="grid products-grid">
        {
          products.map((p) => (
            <li class="card product-card">
              <strong>{p.data.title}</strong>
              <p>{p.data.summary}</p>
            </li>
          ))
        }
      </ul>
      <a class="link-more" href={`${base}products`}>See the full scoring &amp; shortlist &rarr;</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta card">
        <div>
          <h2>How to contribute</h2>
          <p>
            Everything happens on GitHub &mdash; propose a product,
            challenge a principle, or submit a design as a pull request.
          </p>
        </div>
        <a class="btn btn-primary" href="https://github.com/3IVIS/openecogoods">
          github.com/3IVIS/openecogoods
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background:
      radial-gradient(circle at 15% 20%, var(--accent-soft), transparent 55%),
      radial-gradient(circle at 85% 0%, var(--clay-soft), transparent 45%);
    padding: 4.5rem 0 4rem;
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    max-width: 40rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0.75rem 0 1.25rem;
  }

  .lede,
  .section-lede {
    font-size: 1.08rem;
    color: var(--ink-soft);
    max-width: 38rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }

  .section {
    padding: 4rem 0;
  }

  .section-alt {
    background: var(--paper-alt);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .section h2 {
    font-size: 1.7rem;
    margin: 0 0 0.75rem;
  }

  .grid {
    list-style: none;
    margin: 2rem 0 1.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.1rem;
  }

  .card {
    padding: 1.5rem;
  }

  .principle-card,
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .principle-card strong,
  .product-card strong {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--ink);
  }

  .principle-card p,
  .product-card p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
  }

  .principle-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .link-more {
    font-weight: 600;
    text-decoration: none;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding: 2rem 2.25rem;
  }

  .cta h2 {
    font-size: 1.4rem;
    margin: 0 0 0.4rem;
  }

  .cta p {
    margin: 0;
    color: var(--ink-soft);
    max-width: 28rem;
  }
</style>
