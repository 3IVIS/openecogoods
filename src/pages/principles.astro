---
import Layout from "../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

const entries = (await getCollection("principles")).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<Layout
  title="Principles"
  description="The OpenEcoGoods principles: what counts as an ecological design here."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "The OpenEcoGoods Principles",
    itemListElement: rendered.map(({ entry }, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: entry.data.title,
      description: entry.data.summary,
      url: `https://openecogoods.com/principles#${entry.id}`,
    })),
  })} />

  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Principles</span>
      <h1>The OpenEcoGoods Principles</h1>
      <p class="draft-note">
        <span class="tag">v0.1 &middot; draft</span>
        Disagree with one of these?
        <a href="https://github.com/3IVIS/openecogoods/issues/new?template=propose-principle-change.md">
          Open an issue
        </a>
        and make the case.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        rendered.map(({ entry, Content }) => (
          <article id={entry.id} class="card principle">
            <div class="principle-head">
              <span class="principle-number">{entry.data.order}</span>
              <h2>{entry.data.title}</h2>
            </div>
            <div class="principle-body">
              <Content />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 10% 0%, var(--accent-soft), transparent 50%);
  }

  .page-header h1 {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    margin: 0.5rem 0 1rem;
  }

  .draft-note {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0;
  }

  .section {
    padding: 3rem 0 4rem;
  }

  .principle {
    padding: 1.75rem 2rem;
    margin-bottom: 1.25rem;
    scroll-margin-top: 5.5rem;
  }

  .principle-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .principle-number {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-weight: 700;
    font-family: var(--font-serif);
  }

  .principle-head h2 {
    font-size: 1.3rem;
    margin: 0;
  }

  .principle-body :global(p) {
    margin: 0 0 0.75rem;
    color: var(--ink-soft);
  }

  .principle-body :global(ul) {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--ink-soft);
  }

  .principle-body :global(li) {
    margin-bottom: 0.4rem;
  }

  .principle-body :global(li:last-child) {
    margin-bottom: 0;
  }
</style>
