---
import Layout from "../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

const entries = (await getCollection("products")).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const groupInfo = {
  everyday: {
    title: "High-volume, low-lifespan everyday items",
    intro:
      "Individually cheap, sold in the billions, and discarded within months rather than years. The cumulative impact comes from volume × turnover, not any single item's footprint.",
  },
  "longer-cycle": {
    title: "Longer-cycle household goods",
    intro:
      "Bigger-ticket, more considered purchases, replaced over years rather than months — the impact case here is more about material honesty and repairability than raw churn.",
  },
} as const;

const groups = (Object.keys(groupInfo) as Array<keyof typeof groupInfo>).map(
  (key) => ({
    key,
    ...groupInfo[key],
    items: rendered.filter((r) => r.entry.data.group === key),
  }),
);

const rubric = [
  {
    title: "Environmental impact today",
    detail: "Weighted heaviest: how much waste/emissions does this category cause right now?",
  },
  {
    title: "Feasibility of open, distributed manufacture",
    detail: "Can this realistically be built from open designs in a makerspace or small shop, without heavy capital investment?",
  },
  {
    title: "Ubiquity & replaceability",
    detail: "How standardized and genericizable is the category?",
  },
  {
    title: "Likely community interest",
    detail: "Is there existing maker/community expertise to draw on?",
  },
];
---

<Layout
  title="Products"
  description="How we pick which products to design first, and the current candidate shortlist."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "OpenEcoGoods candidate product shortlist",
    itemListElement: rendered.map(({ entry }, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: entry.data.title,
      description: entry.data.summary,
      url: `https://openecogoods.com/products#${entry.id}`,
    })),
  })} />

  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Products</span>
      <h1>What should we design first?</h1>
      <p class="draft-note">
        <span class="tag clay">v0.1 &middot; draft shortlist</span>
        Not a decision.
        <a href="https://github.com/3IVIS/openecogoods/issues/new?template=propose-product.md">
          Propose a product
        </a>
        or argue for reordering this list on GitHub.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>How we score candidates</h2>
      <ul class="grid rubric-grid">
        {
          rubric.map((r) => (
            <li class="card rubric-card">
              <strong>{r.title}</strong>
              <p>{r.detail}</p>
            </li>
          ))
        }
      </ul>
      <p class="rubric-note">
        Impact and feasibility below are rough 1&ndash;5 scores, not precise
        measurements.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Candidate shortlist</h2>
      <p class="shortlist-note">
        Volume and lifespan figures below are rough estimates drawn from
        public reporting, not primary research — where we couldn't find a
        credible number, we say so. Better sources welcome via GitHub.
      </p>

      {
        groups.map((group) => (
          <div class="product-group">
            <div class="group-head">
              <h3>{group.title}</h3>
              <p>{group.intro}</p>
            </div>
            <div class="shortlist">
              {group.items.map(({ entry, Content }) => (
                <article id={entry.id} class="card product">
                  <div class="product-head">
                    <div>
                      <h4>{entry.data.title}</h4>
                      <ul class="examples">
                        {entry.data.examples.map((ex) => (
                          <li>{ex}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="scores">
                      <div class="score">
                        <span class="score-label">Impact</span>
                        <span class="score-bar">
                          <span
                            class="score-fill"
                            style={`width: ${(entry.data.impact / 5) * 100}%`}
                          />
                        </span>
                      </div>
                      <div class="score">
                        <span class="score-label">Feasibility</span>
                        <span class="score-bar">
                          <span
                            class="score-fill clay"
                            style={`width: ${(entry.data.feasibility / 5) * 100}%`}
                          />
                        </span>
                      </div>
                    </div>
                  </div>

                  <dl class="facts">
                    <div class="fact">
                      <dt>Annual volume</dt>
                      <dd>{entry.data.annualVolume}</dd>
                    </div>
                    <div class="fact">
                      <dt>Typical lifespan</dt>
                      <dd>{entry.data.lifespan}</dd>
                    </div>
                  </dl>

                  <div class="product-body">
                    <Content />
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 90% 0%, var(--clay-soft), transparent 50%);
  }

  .page-header h1 {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    margin: 0.5rem 0 1rem;
  }

  .draft-note {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0;
  }

  .section {
    padding: 3rem 0 4rem;
  }

  .section h2 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }

  .grid {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .rubric-card {
    padding: 1.25rem 1.4rem;
  }

  .rubric-card strong {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--ink);
  }

  .rubric-card p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .rubric-note {
    color: var(--ink-faint);
    font-size: 0.88rem;
    margin-top: 1.25rem;
  }

  .shortlist-note {
    color: var(--ink-faint);
    font-size: 0.88rem;
    max-width: 34rem;
    margin: 0.5rem 0 0;
  }

  .product-group {
    margin-top: 2.5rem;
  }

  .product-group:first-child {
    margin-top: 1.5rem;
  }

  .group-head {
    margin-bottom: 1.25rem;
  }

  .group-head h3 {
    font-size: 1.15rem;
    margin: 0 0 0.35rem;
  }

  .group-head p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
    max-width: 38rem;
  }

  .shortlist {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .product {
    padding: 1.75rem 2rem;
    scroll-margin-top: 5.5rem;
  }

  .product-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .product-head h4 {
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }

  .examples {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .examples li {
    font-size: 0.78rem;
    color: var(--ink-soft);
    background: var(--paper-alt);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.75rem 1.5rem;
    background: var(--paper-alt);
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    padding: 0.9rem 1.1rem;
    margin: 1rem 0;
  }

  .fact dt {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.2rem;
  }

  .fact dd {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .scores {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .score {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .score-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .score-bar {
    display: inline-block;
    width: 5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--paper-alt);
    overflow: hidden;
  }

  .score-fill {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
  }

  .score-fill.clay {
    background: var(--clay);
  }

  .product-body :global(p) {
    margin: 0;
    color: var(--ink-soft);
  }
</style>
