---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const GITHUB_URL = "https://github.com/3IVIS/openecogoods";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · OpenEcoGoods</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={base}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path
              fill="currentColor"
              d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66l.95-2.3C7.46 20.04 8.68 20 10 20c8.29 0 12-4 12-13c0-.58 0-1.16-.09-1.75c-.61.48-1.62 1.05-2.91 1.75c-.94.5-2.08.79-3.15.9c-.62.06-1.29.1-1.85.1z"
            ></path>
          </svg>
          <span>OpenEcoGoods</span>
        </a>
        <nav>
          <a href={`${base}principles`}>Principles</a>
          <a href={`${base}products`}>Products</a>
          <a class="nav-github" href={GITHUB_URL}>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59c.4.07.55-.17.55-.38c0-.19-.01-.82-.01-1.49c-2.01.37-2.53-.49-2.69-.94c-.09-.23-.48-.94-.82-1.13c-.28-.15-.68-.52-.01-.53c.63-.01 1.08.58 1.23.82c.72 1.21 1.87.87 2.33.66c.07-.52.28-.87.51-1.07c-1.78-.2-3.64-.89-3.64-3.95c0-.87.31-1.59.82-2.15c-.08-.2-.36-1.02.08-2.12c0 0 .67-.21 2.2.82c.64-.18 1.32-.27 2-.27c.68 0 1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82c.44 1.1.16 1.92.08 2.12c.51.56.82 1.27.82 2.15c0 3.07-1.87 3.75-3.65 3.95c.29.25.54.73.54 1.48c0 1.07-.01 1.93-.01 2.2c0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
              ></path>
            </svg>
            <span>GitHub</span>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-brand">OpenEcoGoods</p>
        <p>
          A community project. Everything here is a draft, open for revision
          — <a href={GITHUB_URL}>propose a change on GitHub</a>.
        </p>
        <p class="footer-meta">CERN-OHL-S v2 · v0.1</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #202e1b;
    --ink-soft: #52604a;
    --ink-faint: #7c876f;
    --paper: #faf8f1;
    --paper-alt: #f0ecdd;
    --paper-card: #ffffff;
    --line: #ddd6bf;
    --accent: #4c7a3f;
    --accent-dark: #345c29;
    --accent-soft: #e4ecd9;
    --clay: #b5602f;
    --clay-soft: #f3e3d6;
    --shadow: 0 1px 2px rgba(32, 46, 27, 0.04), 0 6px 20px -8px rgba(32, 46, 27, 0.12);
    --radius: 0.9rem;
    --font-serif: "Iowan Old Style", "Palatino Linotype", "Georgia", serif;
    --font-sans:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto,
      "Helvetica Neue", Arial, sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #eae7d9;
      --ink-soft: #bcc3ac;
      --ink-faint: #8b937d;
      --paper: #161c13;
      --paper-alt: #1d2418;
      --paper-card: #212a1b;
      --line: #333d2a;
      --accent: #7ab567;
      --accent-dark: #93cc80;
      --accent-soft: #263420;
      --clay: #e08a55;
      --clay-soft: #33261d;
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.2), 0 6px 24px -8px rgba(0, 0, 0, 0.5);
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  .container {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  a {
    color: var(--accent-dark);
  }

  /* header */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.2rem;
    text-decoration: none;
    color: var(--ink);
    letter-spacing: 0.01em;
  }

  .brand svg {
    color: var(--accent);
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .site-header nav a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .site-header nav a:hover {
    color: var(--accent-dark);
  }

  .nav-github {
    display: inline-flex !important;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  /* main */

  main {
    padding-bottom: 2rem;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-serif);
    color: var(--ink);
    line-height: 1.2;
    font-weight: 700;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-dark);
    margin-bottom: 0.75rem;
  }

  .tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-dark);
  }

  .tag.clay {
    background: var(--clay-soft);
    color: var(--clay);
  }

  /* buttons */

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1.3rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-primary {
    background: var(--accent-dark);
    color: #fdfcf6;
    box-shadow: var(--shadow);
  }

  .btn-ghost {
    background: transparent;
    border-color: var(--line);
    color: var(--ink);
  }

  /* cards */

  .card {
    background: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  /* footer */

  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--paper-alt);
  }

  .footer-inner {
    padding: 2.5rem 1.5rem 3rem;
    text-align: center;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .footer-brand {
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }

  .footer-meta {
    color: var(--ink-faint);
    font-size: 0.8rem;
    margin-top: 0.75rem;
  }

  code,
  pre {
    font-family: "SFMono-Regular", Consolas, monospace;
  }
</style>
